# Copy to .env (git-ignored). Every service is optional; the game runs without any.

# Runware: LLM brains and voices. https://my.runware.ai -> API keys
RUNWARE_API_KEY=
LLM_MODEL=minimax:m3@0
# Hard cap on LLM calls per server run
LLM_CALL_CAP=1500

# Bruin Cloud: alibi scan. Team Settings -> API Keys, custom access, ability
# "connection-set:cloud-query". The set ID is next to the connection set's name.
BRUIN_TOKEN=
BRUIN_CONNECTION_SET_ID=
BRUIN_CONNECTION=warehouse

# Postgres that Bruin Cloud can reach
DATABASE_URL=

# Band: one remote agent per line. app.band.ai -> Agents -> Connect remote agent
BAND_VELVET_ID=
BAND_VELVET_KEY=
BAND_BOOTS_ID=
BAND_BOOTS_KEY=
BAND_SABLE_ID=
BAND_SABLE_KEY=
BAND_CAPTAIN_ID=
BAND_CAPTAIN_KEY=

# Telem: viral scenario research
TELEM_API_KEY=

PORT=8787
PUBLIC_URL=
